# === Python 编译缓存与虚拟环境 ===
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
ENV/

# === PyInstaller 打包临时文件与产物 ===
build/
dist/
*.manifest
*.spec

# === 运行时本地生成的可写数据与日志（防止泄露监测 IP） ===
config.json
*.db
*.db-wal
*.db-shm
data/
logs/
*.log
crash.log

# === 本地动态生成的音频与图标资源 ===
assets/alert_warning.wav
assets/alert_alarm.wav
assets/alert_recovery.wav
assets/icon.ico

# === 本地评审补丁文件（git am 应用后即可删除，不入库） ===
*.patch

# === IDE 与系统临时文件 ===
.idea/
.vscode/
*.swp
Thumbs.db
